{
    "_description": "Quick test SFT config",
    "model_name": "Qwen/Qwen3.5-0.8B",
    "data": "logs/positive_training_samples.jsonl",
    "mask_triples": true,
    "max_length": 2048,
    "batch_size": 2,
    "grad_accum": 2,
    "lr": 2e-5,
    "max_steps": 20,
    "save_steps": 50,
    "logging_steps": 2,
    "eval_steps": 5,
    "lora_r": 8,
    "lora_alpha": 16,
    "lora_dropout": 0.05,
    "weight_decay": 0.01,
    "optim": "adamw_torch",
    "betas": [0.9, 0.999],
    "val_split": 0.1,
    "report_to": "wandb",
    "wandb_project": "sft_training",
    "wandb_run_name": "test-val-loss"
}
